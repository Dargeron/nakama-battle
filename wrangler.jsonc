{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ultimate-nakama-battle",
  "main": "server/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "NakamaRoom"}]
  },
  "migrations": [
    {"tag": "nakama-online-v1", "new_sqlite_classes": ["NakamaRoom"]}
  ]
}
